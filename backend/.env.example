# Environment Variables
# DATABASE_URL=postgresql://chatbranch_user:chatbranch_password@localhost/chatbranch
DATABASE_URL=postgresql://chatbranch:chatbranch_password@postgres:5432/chatbranch

# Use this to persist login sessions
JWT_SECRET_KEY=dev-secret-key-12345678901234567890

# LLM Configuration
USE_DUMMY_RESPONSES=true  # Set to 'false' to use real LLM APIs

# Default LLM gateway: set an OpenRouter API key to enable real LLM calls (or supply a frontend-only OpenRouter key)
OPENROUTER_API_KEY=project_openrouter_key_here
