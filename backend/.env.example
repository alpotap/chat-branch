# Environment Variables
# DATABASE_URL=postgresql://chatbranch_user:chatbranch_password@localhost/chatbranch
DATABASE_URL=postgresql://chatbranch:chatbranch_password@postgres:5432/chatbranch

# Authentication
JWT_SECRET_KEY=dev-secret-key-change-in-production-12345678901234567890

# LLM Configuration
USE_DUMMY_RESPONSES=true  # Set to 'false' to use real LLM APIs
# OpenRouter is the default LLM gateway used by the backend. Set this to a valid
# OpenRouter API key to enable real LLM calls. Alternatively, advanced users can
# provide an OpenRouter API key from the frontend (client-only storage) for
# single-request use.
OPENROUTER_API_KEY=project_openrouter_key_here
