# Environment Variables
# DATABASE_URL=postgresql://chatbranch_user:chatbranch_password@localhost/chatbranch
DATABASE_URL=postgresql://chatbranch:chatbranch_password@postgres:5432/chatbranch

# Authentication
JWT_SECRET_KEY=dev-secret-key-change-in-production-12345678901234567890

# LLM Configuration
USE_DUMMY_RESPONSES=true  # Set to 'false' to use real LLM APIs
GEMINI_API_KEY=project_key_here

# LLM API Keys (only needed if USE_DUMMY_RESPONSES=false)
# OPENAI_API_KEY=your_openai_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here

# Optional: AWS Bedrock settings (for future use)
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=us-east-1ment Variables

